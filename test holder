@app.route("/sync", methods=["POST"])
def sync():
    """
    Body: { "user_id": "...", "device_id": "...", "device_token": "...", "name": "...", "language": "en" }
    Response: { "encrypted_user_key": "<base64(nonce+ciphertext+tag)>" }
    The encrypted_user_key is the user's AES key (base64 string) encrypted with the AppCommonKey (server-side).
    """
    try:
        data = request.get_json(force=True) or {}
        user_id = data.get("user_id")
        device_id = data.get("device_id")
        device_token = data.get("device_token")
        name = data.get("name")
        language = data.get("language", "en")

        if not user_id:
            return jsonify({"error": "user_id required"}), 400

        with SessionLocal() as session:
            user = get_user(session, user_id)
            if not user:
                user = create_user(session, user_id, device_id=device_id, device_token=device_token, name=name, language=language)
            else:
                # update device info and metadata
                user.device_id = device_id or user.device_id
                user.device_token = device_token or user.device_token
                user.name = name or user.name
                user.language = language or user.language
                user.last_seen = datetime.utcnow()
                session.commit()

            # upsert device table
            if device_token:
                upsert_device(session, user_id, device_token)

            # encrypt the user's AES key (which itself is base64) with AppCommonKey
            encrypted_user_key = aes_gcm_encrypt_with_key_bytes(APPCOMMON_KEY_BYTES, user.aes_key_b64.encode("utf-8"))

            return jsonify({"encrypted_user_key": encrypted_user_key, "message": "synced"}), 200

    except Exception as e:
        traceback.print_exc()
        return jsonify({"error": "internal", "detail": str(e)}), 500

@app.route("/register_device", methods=["POST"])
def register_device():
    """
    Body: {"user_id": "...", "device_token": "...", "platform": "android"}
    """
    try:
        data = request.get_json(force=True) or {}
        user_id = data.get("user_id")
        token = data.get("device_token")
        platform = data.get("platform", "android")
        if not user_id or not token:
            return jsonify({"error":"user_id and device_token required"}), 400

        with SessionLocal() as session:
            upsert_device(session, user_id, token, platform)
            # also update user table device_token for convenience
            user = get_user(session, user_id)
            if user:
                user.device_token = token
                session.commit()
        return jsonify({"ok": True})
    except Exception as e:
        traceback.print_exc()
        return jsonify({"error": "internal"}), 500

@app.route("/news", methods=["POST"])
def news():
    """
    Body:
      { "user_id": "...", "lat": 12.34, "lon": 56.78, "max_items": 5 (optional) }

    Response:
      { "data": "<base64 nonce+ciphertext+tag>" }
    """
    try:
        payload = request.get_json(force=True) or {}
        user_id = payload.get("user_id")
        lat = payload.get("lat")
        lon = payload.get("lon")
        max_items = int(payload.get("max_items", 5))

        if not user_id:
            return jsonify({"error": "user_id required"}), 400
        if lat is None or lon is None:
            return jsonify({"error": "lat and lon required"}), 400

        with SessionLocal() as session:
            user = get_user(session, user_id)
            if not user:
                return jsonify({"error": "user not found; sync first"}), 400

            # resolve city (update user city)
            city = reverse_geocode_city(float(lat), float(lon)) or "your area"
            user.city = city
            user.last_seen = datetime.utcnow()
            session.commit()
            user_key_b64 = user.aes_key_b64

        # Check cache first
        now = time.time()
        cached = NEWS_CACHE.get(city)
        if cached and now - cached["timestamp"] < CACHE_TTL:
            result = cached["data"]
        else:
            # fetch & summarize
            entries = fetch_news_for_city(city, max_items=max_items)
            clean_list = []
            for e in entries:
                combined = f"{e['title']}\n{e['summary']}"
                summary = summarize_with_gemini(combined)
                clean_list.append({"headline": e['title'], "summary": summary})
            result = {"city": city, "news": clean_list, "fetched_at": datetime.utcnow(timezone.utc).isoformat()}
            NEWS_CACHE[city] = {"data": result, "timestamp": now}

        # encrypt with user's key
        encrypted = aes_gcm_encrypt_with_key_b64(user_key_b64, json.dumps(result, ensure_ascii=False))
        return jsonify({"data": encrypted})

    except Exception as e:
        traceback.print_exc()
        return jsonify({"error": "internal", "detail": str(e)}), 500

# Protected cron endpoint (Render cron should POST with header X-Cron-Secret)
@app.route("/cron/check-news", methods=["POST"])
def cron_check_news():
    """
    This endpoint should be triggered by Render Scheduled Job (HTTP POST every N minutes)
    Protect with header: X-Cron-Secret: <CRON_SECRET>
    """
    try:
        secret = request.headers.get("X-Cron-Secret")
        if not secret or secret != CRON_SECRET:
            return jsonify({"error": "unauthorized"}), 401

        # Build mapping: city -> list of users (user objects)
        with SessionLocal() as session:
            users = session.query(User).filter(User.city.isnot(None)).all()
            city_groups = {}
            for u in users:
                city_groups.setdefault(u.city, []).append(u)

        # For each city, ensure cached summary exists (fetch if expired)
        for city, user_list in city_groups.items():
            now = time.time()
            cached = NEWS_CACHE.get(city)
            if not cached or now - cached["timestamp"] >= CACHE_TTL:
                entries = fetch_news_for_city(city, max_items=5)
                summarized_list = []
                for e in entries:
                    combined = f"{e['title']}\n{e['summary']}"
                    summary_text = summarize_with_gemini(combined)
                    summarized_list.append({"title": e['title'], "summary": summary_text})
                result = {"city": city, "news": summarized_list, "fetched_at": datetime.utcnow(timezone.utc).isoformat()}
                NEWS_CACHE[city] = {"data": result, "timestamp": now}
            else:
                result = cached["data"]

            # Compute a hash based on headlines to detect new news
            items_for_hash = [{"title": it["title"]} for it in result["news"]]
            new_hash = compute_news_hash(items_for_hash)

            # For each user in this city, check their last hash and notify if changed (and priority HIGH)
            for user in user_list:
                with SessionLocal() as session:
                    uch = session.query(UserCityHash).filter_by(user_id=user.user_id, city=city).first()
                    previous_hash = uch.last_hash if uch else None

                    # if same hash, nothing new for that user
                    if previous_hash == new_hash:
                        continue

                    # classify priority for the city based on concatenated news text (we can classify per item or per city; choose per item if needed)
                    # We'll check top N items and notify only if at least one item is HIGH
                    high_items = []
                    for it in result["news"]:
                        text_for_class = f"{it['headline']}\n{it['summary']}"
                        priority = classify_priority_for_city(text_for_class, city)
                        if priority == "HIGH":
                            high_items.append(it)

                    # If no high-priority items, skip notification for this user
                    if not high_items:
                        # still update hash so user won't be rechecked for same headlines repeatedly
                        if uch:
                            uch.last_hash = new_hash
                            session.commit()
                        else:
                            upsert_user_city_hash(session, user.user_id, city, new_hash)
                        continue

                    # update or create user city hash
                    if uch:
                        uch.last_hash = new_hash
                        session.commit()
                    else:
                        upsert_user_city_hash(session, user.user_id, city, new_hash)

                    # Prepare payload: we will include only high_items in payload
                    payload = {"city": city, "high_priority": high_items, "fetched_at": result["fetched_at"]}

                    # Encrypt per-user payload with their AES key
                    encrypted_payload = aes_gcm_encrypt_with_key_b64(user.aes_key_b64, json.dumps(payload, ensure_ascii=False))

                    # Send push to all devices of this user
                    # get user's devices from Device table
                    with SessionLocal() as ds:
                        devices = ds.query(Device).filter_by(user_id=user.user_id).all()
                        for dev in devices:
                            token = dev.device_token
                            title = f"Important update in {city}"
                            body = high_items[0]["headline"] if high_items else f"Important news in {city}"
                            try:
                                send_push_to_token(token, title, body, data_payload={"enc": encrypted_payload})
                            except Exception as e:
                                print("Push send error:", e)

        return jsonify({"ok": True})
    except Exception as e:
        traceback.print_exc()
        return jsonify({"error": "internal", "detail": str(e)}), 500
    
