def init_firebase():
     # Firebase disabled intentionally
    if os.getenv("FIREBASE_ENABLED", "0") == "0":
        print("⚠ Firebase disabled for local/testing mode.")
        return
    try:
        if FIREBASE_CREDENTIALS_JSON:
            # try treat as base64-encoded JSON or raw JSON
            s = FIREBASE_CREDENTIALS_JSON.strip()
            try:
                # base64 case
                if not s.startswith("{"):
                    raw = base64.b64decode(s).decode("utf-8")
                else:
                    raw = s
                cred_json = json.loads(raw)
                cred = credentials.Certificate(cred_json)
            except Exception:
                # fallback: treat as path
                cred = credentials.Certificate(FIREBASE_CREDENTIALS_JSON)
        else:
            cred = None

        if not firebase_admin._apps:
            if cred:
                firebase_admin.initialize_app(cred)
            else:
                firebase_admin.initialize_app()
    except Exception as e:
        print("Firebase init error:", e)
        raise

init_firebase()

# -----------------------
# DB (SQLAlchemy)
