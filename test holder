# -----------------------
# AES helpers
# -----------------------
def generate_aes_b64():
    return base64.b64encode(os.urandom(32)).decode()

def aes_gcm_encrypt_with_key_bytes(key_bytes: bytes, plaintext_bytes: bytes) -> str:
    nonce = get_random_bytes(12)
    cipher = AES.new(key_bytes, AES.MODE_GCM, nonce=nonce)
    ciphertext, tag = cipher.encrypt_and_digest(plaintext_bytes)
    packed = nonce + ciphertext + tag
    return base64.b64encode(packed).decode()

def aes_gcm_encrypt_with_key_b64(key_b64: str, plaintext_str: str) -> str:
    key = base64.b64decode(key_b64)
    return aes_gcm_encrypt_with_key_bytes(key, plaintext_str.encode("utf-8"))

# -----------------------
# News fetching + summarization + classification
# -----------------------
def reverse_geocode_city(lat: float, lon: float) -> str:
    try:
        loc = geolocator.reverse(f"{lat}, {lon}", exactly_one=True, language="en")
        if not loc:
            return None
        addr = loc.raw.get("address", {})
        return addr.get("city") or addr.get("town") or addr.get("village") or addr.get("state") or addr.get("country")
    except Exception:
        return None

def fetch_news_for_city(city: str, max_items: int = 5):
    try:
        q = requests.utils.quote(city)
        url = f"https://news.google.com/rss/search?q={q}&hl=en-IN&gl=IN&ceid=IN:en"
        r = requests.get(url, timeout=10)
        feed = feedparser.parse(r.content)
        results = []
        for entry in feed.entries[:max_items]:
            results.append({
                "title": entry.get("title", ""),
                "summary": entry.get("summary", "")
            })
        return results
    except Exception:
        return []

def summarize_with_gemini(text: str) -> str:
    try:
        model = genai.GenerativeModel("gemini-pro")
        prompt = f"Summarize the following news content into 2-3 concise lines suitable for a mobile user:\n\n{text}"
        resp = model.generate_content(prompt)
        return (resp.text or "").strip()
    except Exception:
        # fallback simple trim
        return text[:400] + ("..." if len(text) > 400 else "")

def classify_priority_for_city(text: str, city: str) -> str:
    """
    Returns "HIGH" or "LOW" indicating whether the given text is high priority for city.
    """
    try:
        model = genai.GenerativeModel("gemini-pro")
        prompt = f"""
You are an assistant classifying whether the following news item is HIGH priority for people living in the city: {city}.

HIGH priority examples:
- Disasters, floods, storms, earthquakes, fires, major accidents
- City-specific government or police alerts
- Health emergencies, power outages, traffic blockages affecting city mobility
- Any event expected to affect safety, health or daily life of residents in {city}

LOW priority examples:
- Entertainment, sports, routine business news, political debate without local impact
- News clearly about another city or region not affecting {city}

Only respond with HIGH or LOW.

News:
{text}
"""
        resp = model.generate_content(prompt)
        out = (resp.text or "").strip().upper()
        return "HIGH" if "HIGH" in out else "LOW"
    except Exception:
        # default LOW on error to avoid spamming users
        return "LOW"

def compute_news_hash(items):
    s = "\n".join(it['title'] for it in items)
    return hashlib.sha256(s.encode("utf-8")).hexdigest()

# -----------------------
# Push helper (Firebase)
# -----------------------
def send_push_to_token(token: str, title: str, body: str, data_payload: dict = None):
    if not token:
        return None
    message = messaging.Message(
        notification=messaging.Notification(title=title, body=body),
        token=token,
        android=messaging.AndroidConfig(priority="high"),
        data=data_payload or {}
    )
    resp = messaging.send(message)
    return resp

# -----------------------
# DB helpers
# -----------------------
def get_user(session, user_id: str):
    return session.query(User).filter_by(user_id=user_id).first()

def create_user(session, user_id: str, device_id=None, device_token=None, name=None, language="en"):
    key_b64 = generate_aes_b64()
    user = User(
        user_id=user_id,
        aes_key_b64=key_b64,
        device_id=device_id,
        device_token=device_token,
        name=name,
        language=language,
        city=None
    )
    session.add(user)
    session.commit()
    session.refresh(user)
    return user

def upsert_device(session, user_id: str, device_token: str, platform: str = "android"):
    existing = session.query(Device).filter_by(user_id=user_id, device_token=device_token).first()
    if existing:
        return existing
    d = Device(user_id=user_id, device_token=device_token, platform=platform)
    session.add(d)
    session.commit()
    return d

def upsert_user_city_hash(session, user_id: str, city: str, new_hash: str):
    uch = session.query(UserCityHash).filter_by(user_id=user_id, city=city).first()
    if not uch:
        uch = UserCityHash(user_id=user_id, city=city, last_hash=new_hash)
        session.add(uch)
    else:
        uch.last_hash = new_hash
    session.commit()
    return uch

